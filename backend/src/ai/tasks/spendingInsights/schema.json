{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Financial insights narrative",
  "description": "Ranked commentary that may cite only fact and action ids from the analysis packet.",
  "properties": {
    "headline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "description": "The single most important takeaway, in one plain sentence."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 420,
      "description": "Two sentences expanding the headline using only supplied figures."
    },
    "insights": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "factId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "Id copied from the packet facts array."
          },
          "sentiment": {
            "type": "string",
            "enum": ["positive", "warning", "neutral"]
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "detail": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "required": ["factId", "sentiment", "title", "detail"],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "Id copied from the packet candidates array."
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "detail": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "required": ["candidateId", "title", "detail"],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "factId": { "type": "string", "minLength": 1, "maxLength": 40 },
          "text": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "required": ["factId", "text"],
        "additionalProperties": false
      }
    }
  },
  "required": ["headline", "summary", "insights", "actions", "notes"],
  "additionalProperties": false
}
