generator client {
  provider      = "prisma-client-js"
  // Generated into src/ so TypeScript/IDE resolve Prisma types without relying on
  // the @prisma/client → node_modules/.prisma re-export chain.
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Base entity convention
//
// Prisma has no model inheritance, so the audit fields below are copy-pasted
// onto every model in this schema. Values are populated automatically by the
// Prisma client extension in src/lib/prisma.ts, which reads the current actor
// id from the per-request AsyncLocalStorage context (src/lib/requestContext.ts):
//
//   id           cuid generated by Prisma
//   createdAt    set on insert
//   updatedAt    set on insert and every update
//   createdById  actor id from request context (null = system / self-signup)
//   updatedById  actor id from request context (null = system)
//   deletedAt    soft-delete marker; all reads must filter `where: { deletedAt: null }`
//
// When you add a new model, copy this block verbatim:
//
//   id           String    @id @default(cuid())
//   createdAt    DateTime  @default(now())
//   updatedAt    DateTime  @updatedAt
//   createdById  String?
//   updatedById  String?
//   deletedAt    DateTime?
//
// createdById / updatedById are intentionally plain String? without Prisma
// relations to avoid self-referential cycles (especially on User) and to keep
// migrations simple. Join in the application layer when needed.
// =============================================================================

model User {
  email        String @unique
  passwordHash String
  name         String

  // Base audit fields
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  transactions         Transaction[]
  budget               Budget?
  recurringIncomes     RecurringIncome[]
  recurringExpenses    RecurringExpense[]
  categories           Category[]
  passwordResetTokens  PasswordResetToken[]
  recurringOccurrences RecurringOccurrence[]
  contacts             Contact[]
  splits               TransactionSplit[]
  recurringShares      RecurringExpenseShare[]
  reimbursements       Reimbursement[]
  goals                Goal[]

  @@index([deletedAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  // sha256 of the 6-digit code — the raw code is never stored.
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?

  // Base audit fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([deletedAt])
}

model Category {
  id       String  @id @default(cuid())
  key      String  @unique
  userId   String?
  label    String
  abbr     String
  color    String
  bgTint   String
  sort     Int
  isSystem Boolean @default(true)

  // Base audit fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  user              User?              @relation(fields: [userId], references: [id])
  transactions      Transaction[]
  recurringExpenses RecurringExpense[]

  @@index([userId])
  @@index([deletedAt])
}

model Transaction {
  id                 String   @id @default(cuid())
  userId             String
  categoryId         String
  // positive = income, negative = expense
  amount             Decimal  @db.Decimal(12, 2)
  note               String?
  occurredAt         DateTime
  recurringIncomeId  String?
  recurringExpenseId String?
  // Portion of this expense owed by other people (sum of TransactionSplit.owedAmount).
  // Spending aggregations use SUM(amount + sharedOwedTotal) so only the user's own
  // share counts; balance keeps using the raw amount (full cash outflow). 0 for
  // unshared transactions and income.
  sharedOwedTotal    Decimal  @default(0) @db.Decimal(12, 2)
  // True when this is a positive inflow recording a contact's repayment. Excluded
  // from income totals/analytics, but still counted in balance (real cash received).
  isReimbursement    Boolean  @default(false)

  // Base audit fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  user                User                 @relation(fields: [userId], references: [id])
  category            Category             @relation(fields: [categoryId], references: [id])
  recurringIncome     RecurringIncome?     @relation(fields: [recurringIncomeId], references: [id])
  recurringExpense    RecurringExpense?    @relation(fields: [recurringExpenseId], references: [id])
  recurringOccurrence RecurringOccurrence?
  splits              TransactionSplit[]
  reimbursement       Reimbursement?

  @@index([userId, occurredAt])
  @@index([recurringIncomeId, occurredAt])
  @@index([recurringExpenseId, occurredAt])
  @@index([userId, isReimbursement])
  @@index([deletedAt])
}

model RecurringIncome {
  id         String  @id @default(cuid())
  userId     String
  label      String
  amount     Decimal @db.Decimal(12, 2)
  dayOfMonth Int
  isActive   Boolean @default(true)

  // Base audit fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  user         User                  @relation(fields: [userId], references: [id])
  transactions Transaction[]
  occurrences  RecurringOccurrence[]

  @@index([userId])
  @@index([deletedAt])
}

enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

model RecurringExpense {
  id           String              @id @default(cuid())
  userId       String
  categoryId   String
  label        String
  // stored as a positive value; materialized into Transactions with sign flipped
  amount       Decimal             @db.Decimal(12, 2)
  frequency    RecurrenceFrequency
  // required iff frequency = CUSTOM
  intervalDays Int?
  // anchor for the recurrence sequence; date-only semantics (no time-of-day)
  anchorDate   DateTime
  isActive     Boolean             @default(true)

  // Base audit fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  user         User                    @relation(fields: [userId], references: [id])
  category     Category                @relation(fields: [categoryId], references: [id])
  transactions Transaction[]
  occurrences  RecurringOccurrence[]
  shares       RecurringExpenseShare[]

  @@index([userId, isActive])
  @@index([deletedAt])
}

enum OccurrenceStatus {
  PENDING
  CONFIRMED
  POSTPONED
}

// A single scheduled instance of a recurring income/expense, tracking its
// confirm/postpone lifecycle. Generated by the materialization step; a real
// Transaction is created only when the user CONFIRMS. Unconfirmed occurrences
// therefore never affect balances/totals/budget.
model RecurringOccurrence {
  id                 String           @id @default(cuid())
  userId             String
  recurringIncomeId  String?
  recurringExpenseId String?
  // Canonical scheduled date from the rule — stable identity, NEVER moves on postpone.
  scheduledFor       DateTime
  // When the user should be (re-)prompted; starts == scheduledFor, moves on postpone.
  dueAt              DateTime
  status             OccurrenceStatus @default(PENDING)
  // Snapshot so the modal stays stable even if the rule changes later.
  amount             Decimal          @db.Decimal(12, 2)
  label              String
  // Set when CONFIRMED.
  transactionId      String?          @unique

  // Base audit fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  user             User              @relation(fields: [userId], references: [id])
  recurringIncome  RecurringIncome?  @relation(fields: [recurringIncomeId], references: [id])
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  transaction      Transaction?      @relation(fields: [transactionId], references: [id])

  @@unique([recurringIncomeId, scheduledFor])
  @@unique([recurringExpenseId, scheduledFor])
  @@index([userId, status, dueAt])
  @@index([deletedAt])
}

// A user-defined savings goal (e.g. "New Car"). Progress is tracked manually:
// the user adds funds (increments savedAmount) or edits the figure directly.
// Goals are independent of balance/transactions — purely aspirational tracking.
model Goal {
  id           String    @id @default(cuid())
  userId       String
  name         String
  // Curated icon key, mapped to a Material IconData on the client.
  icon         String
  // Hex color from CATEGORY_PALETTE (src/schemas/categories.ts).
  color        String
  targetAmount Decimal   @db.Decimal(12, 2)
  savedAmount  Decimal   @default(0) @db.Decimal(12, 2)
  // Optional target date (date-only semantics); drives the "monthly savings"
  // suggestion computed client-side.
  targetDate   DateTime?

  // Cached AI time-to-reach estimate (shape mirrors GoalEstimateDto) and when it
  // was last generated. Served within GOAL_ESTIMATE_TTL_HOURS to avoid re-calling
  // Gemini on every request; null until the user first requests an estimate.
  aiEstimate    Json?
  aiEstimatedAt DateTime?

  // Base audit fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([deletedAt])
}

model Budget {
  id     String  @id @default(cuid())
  userId String  @unique
  amount Decimal @db.Decimal(12, 2)

  // Base audit fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([deletedAt])
}

// A lightweight person the user splits expenses with (e.g. a sibling, flatmate).
// Not an Expensy account — just a name/avatar the user manages locally. The user's
// own share in any split is always implicit (never a Contact row).
model Contact {
  id     String  @id @default(cuid())
  userId String
  name   String
  // Optional avatar tint (hex), chosen client-side from the design palette.
  color  String?

  // Base audit fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  user            User                    @relation(fields: [userId], references: [id])
  splits          TransactionSplit[]
  recurringShares RecurringExpenseShare[]
  reimbursements  Reimbursement[]

  @@index([userId])
  @@index([deletedAt])
}

enum SplitStatus {
  OWED
  PARTIAL
  SETTLED
}

// One contact's share of a single expense Transaction. The user's own share is
// implicit: abs(transaction.amount) - sum(owedAmount across splits).
model TransactionSplit {
  id            String      @id @default(cuid())
  userId        String
  transactionId String
  contactId     String
  // How much this contact owes for this expense (positive).
  owedAmount    Decimal     @db.Decimal(12, 2)
  // How much they've repaid so far (partial payments accumulate here).
  settledAmount Decimal     @default(0) @db.Decimal(12, 2)
  status        SplitStatus @default(OWED)

  // Base audit fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  user           User            @relation(fields: [userId], references: [id])
  transaction    Transaction     @relation(fields: [transactionId], references: [id])
  contact        Contact         @relation(fields: [contactId], references: [id])
  reimbursements Reimbursement[]

  @@index([userId, contactId, status])
  @@index([transactionId])
  @@index([deletedAt])
}

enum ShareType {
  AMOUNT
  PERCENT
}

// Split template on a recurring rule. Applied to each occurrence at confirm time
// to generate that occurrence's TransactionSplit rows.
model RecurringExpenseShare {
  id                 String    @id @default(cuid())
  userId             String
  recurringExpenseId String
  contactId          String
  shareType          ShareType
  // PERCENT: 0..100 of the occurrence amount. AMOUNT: a fixed value.
  shareValue         Decimal   @db.Decimal(12, 2)

  // Base audit fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  user             User             @relation(fields: [userId], references: [id])
  recurringExpense RecurringExpense @relation(fields: [recurringExpenseId], references: [id])
  contact          Contact          @relation(fields: [contactId], references: [id])

  @@index([recurringExpenseId])
  @@index([userId])
  @@index([deletedAt])
}

// A single (possibly partial) repayment from a contact toward a split. Each one
// creates a positive inflow Transaction (isReimbursement = true) so the balance
// reflects the cash received.
model Reimbursement {
  id            String   @id @default(cuid())
  userId        String
  splitId       String
  contactId     String
  amount        Decimal  @db.Decimal(12, 2)
  occurredAt    DateTime
  // The inflow transaction this repayment created.
  transactionId String?  @unique

  // Base audit fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  user        User             @relation(fields: [userId], references: [id])
  split       TransactionSplit @relation(fields: [splitId], references: [id])
  contact     Contact          @relation(fields: [contactId], references: [id])
  transaction Transaction?     @relation(fields: [transactionId], references: [id])

  @@index([userId])
  @@index([splitId])
  @@index([deletedAt])
}
