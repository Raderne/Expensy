generator client {
  provider = "prisma-client-js"
  // Generated into src/ so TypeScript/IDE resolve Prisma types without relying on
  // the @prisma/client → node_modules/.prisma re-export chain.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Base entity convention
//
// Prisma has no model inheritance, so the audit fields below are copy-pasted
// onto every model in this schema. Values are populated automatically by the
// Prisma client extension in src/lib/prisma.ts, which reads the current actor
// id from the per-request AsyncLocalStorage context (src/lib/requestContext.ts):
//
//   id           cuid generated by Prisma
//   createdAt    set on insert
//   updatedAt    set on insert and every update
//   createdById  actor id from request context (null = system / self-signup)
//   updatedById  actor id from request context (null = system)
//   deletedAt    soft-delete marker; all reads must filter `where: { deletedAt: null }`
//
// When you add a new model, copy this block verbatim:
//
//   id           String    @id @default(cuid())
//   createdAt    DateTime  @default(now())
//   updatedAt    DateTime  @updatedAt
//   createdById  String?
//   updatedById  String?
//   deletedAt    DateTime?
//
// createdById / updatedById are intentionally plain String? without Prisma
// relations to avoid self-referential cycles (especially on User) and to keep
// migrations simple. Join in the application layer when needed.
// =============================================================================

model User {
  email        String  @unique
  passwordHash String
  name         String

  // Base audit fields
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  transactions     Transaction[]
  budget           Budget?
  recurringIncomes RecurringIncome[]

  @@index([deletedAt])
}

model Category {
  id       String  @id @default(cuid())
  key      String  @unique
  label    String
  abbr     String
  color    String
  bgTint   String
  sort     Int
  isSystem Boolean @default(true)

  // Required for the $allModels soft-delete extension in src/lib/prisma.ts
  deletedAt DateTime?

  transactions Transaction[]

  @@index([deletedAt])
}

model Transaction {
  id                String   @id @default(cuid())
  userId            String
  categoryId        String
  // positive = income, negative = expense
  amount            Decimal  @db.Decimal(12, 2)
  note              String?
  occurredAt        DateTime
  recurringIncomeId String?

  // Base audit fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  user            User             @relation(fields: [userId], references: [id])
  category        Category         @relation(fields: [categoryId], references: [id])
  recurringIncome RecurringIncome? @relation(fields: [recurringIncomeId], references: [id])

  @@index([userId, occurredAt])
  @@index([recurringIncomeId, occurredAt])
  @@index([deletedAt])
}

model RecurringIncome {
  id         String  @id @default(cuid())
  userId     String
  label      String
  amount     Decimal @db.Decimal(12, 2)
  dayOfMonth Int
  isActive   Boolean @default(true)

  // Base audit fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@index([userId])
  @@index([deletedAt])
}

model Budget {
  id     String  @id @default(cuid())
  userId String  @unique
  amount Decimal @db.Decimal(12, 2)

  // Base audit fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([deletedAt])
}
