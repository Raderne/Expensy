DATABASE_URL=postgresql://expensy:expensy@localhost:5432/expensy
JWT_ACCESS_SECRET=replace-with-32-plus-character-secret-value!
JWT_REFRESH_SECRET=replace-with-another-32-plus-character-secret!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PORT=3000
# Bind all interfaces so phones on your LAN can reach the API (default 0.0.0.0).
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
NODE_ENV=development

# Password reset OTP code lifetime (minutes).
RESET_CODE_TTL_MIN=15
# SMTP — leave SMTP_HOST blank in dev to print reset codes to the server log
# instead of sending email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Expensy <no-reply@expensy.app>

# Google Gemini — powers the AI goal time-to-reach estimate. Leave GEMINI_API_KEY
# blank to disable the feature (endpoint returns 503). Get a free key at
# https://aistudio.google.com/apikey. The free fast model is the default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Default per-call token budgets (a task may override either). Input guards the
# prompt size (oversized prompts fail fast); output caps the response length.
GEMINI_MAX_INPUT_TOKENS=8000
GEMINI_MAX_OUTPUT_TOKENS=1024
# Thinking budget for 2.5+ models. Leave unset to let the model decide; set 0 to
# disable reasoning (faster/cheaper, keeps the output cap meaningful). Tasks may
# override this; the goal estimate sets 0 in code.
# GEMINI_THINKING_BUDGET=0
# Hours a persisted goal estimate is served before recomputing.
GOAL_ESTIMATE_TTL_HOURS=24
# Hours an analytics AI insight is cached (in-memory) before recomputing.
INSIGHTS_TTL_HOURS=12
