{
  "ConnectionStrings": {
    "ApplicationContext": "Host=localhost;Port=5432;Database=Expensy;Username=postgres;Password=Postgres125797;Include Error Detail=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "http://localhost:5118",
    "Audience": "ExpensyBackoffice",
    "Key": "set-via-user-secrets-or-environment-min-32-chars"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "https://localhost:3001" ],
    "PolicyName": "ExpensyCors"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
